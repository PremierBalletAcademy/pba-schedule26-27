async function saveClass(){

  const id =
    document.getElementById("editId").value;

  const branch =
    document.getElementById("adminBranch").value;

  const day =
    document.getElementById("adminDay").value;

  const studio =
    document.getElementById("adminStudio").value;

  const teacher =
    document.getElementById("adminTeacher").value;

  const start_time =
    document.getElementById("adminStart").value.trim();

  const end_time =
    document.getElementById("adminEnd").value.trim();

  const class_name =
    normalizeClassName(
      document.getElementById(
        "adminClassName"
      ).value
    );

  const message =
    document.getElementById(
      "adminMessage"
    );

  if(
    !branch ||
    !day ||
    !studio ||
    !start_time ||
    !end_time ||
    !class_name
  ){

    message.textContent =
      "Please complete all required fields.";

    return;

  }

  if(
    !timeToMinutes(start_time) &&
    !/^12(?::00)?\s*AM$/i.test(start_time)
  ){

    message.textContent =
      "Please enter a valid start time.";

    return;

  }

  if(
    !timeToMinutes(end_time) &&
    !/^12(?::00)?\s*AM$/i.test(end_time)
  ){

    message.textContent =
      "Please enter a valid end time.";

    return;

  }

  const payload = {

    branch,
    day,
    studio,
    start_time,
    end_time,
    class_name,
    teacher:
      teacher || null

  };

  let result;

  if(id){

    result =
      await supabaseClient
        .from("classes")
        .update(payload)
        .eq("id",id);

  }

  else{

    result =
      await supabaseClient
        .from("classes")
        .insert(payload);

  }

  if(result.error){

    message.textContent =
      result.error.message;

    return;

  }

  message.textContent =
    id
      ? "Class updated successfully."
      : "Class added successfully.";

  cancelEdit();

  await loadAdminClasses();

}


