    currentUser?.adminRole !==
    "superior"
  ){

    alert(
      "Only a Superior Administrator can delete administrators."
    );

    return;

  }

  if(
    !confirm(
      `Remove "${admin.email}" as an administrator?`
    )
  )
    return;

  const result =
    await supabaseClient
      .from("admins")
      .delete()
      .eq("id",admin.id);

  if(result.error){

    alert(result.error.message);

    return;

  }

  await loadAdmins();

}


/* =========================================================
   INVITE ADMIN
========================================================= */

async function inviteAdmin(){

  const email =
    document.getElementById(
      "newAdminEmail"
    ).value.trim();

  const role =
    document.getElementById(
      "newAdminRole"
    ).value;

  const message =
    document.getElementById(
      "adminCreateMessage"
    );

  message.textContent = "";

  if(
    currentUser?.adminRole !==
    "superior"
  ){

    message.textContent =
      "Only a Superior Administrator can invite administrators.";

    return;

  }

  if(!email){

    message.textContent =
      "Enter an email address.";

    return;

  }

  try{

    const {
      data,
      error
    } =
      await supabaseClient.functions.invoke(
        "invite-admin",
        {
          body:{
            email,
            role
          }
        }
      );

    if(error)
      throw error;

    if(data?.error)
      throw new Error(data.error);

    message.textContent =
      "Administrator invitation sent successfully.";

    document.getElementById(
      "newAdminEmail"
    ).value = "";

    await loadAdmins();

  }
  catch(error){

    console.error(
      "Admin invitation error:",
      error
    );

    message.textContent =
      error.message ||
      "Unable to invite administrator.";

  }

}


