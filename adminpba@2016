/* =========================================================
   LOGIN / PASSWORD OVERLAYS
========================================================= */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(10,8,12,.96);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
