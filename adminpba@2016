}

.panel{
  background:#242128;
  border:1px solid #403a45;
  border-radius:18px;
  padding:24px;
  margin-bottom:20px;
}

.panel h2{
  margin:0 0 8px;
}

.panelDescription{
  color:#aaa2b0;
  margin-bottom:22px;
}

/* =========================================================
   FORMS
========================================================= */

.formGrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:16px;
}

.formGrid .full{
  grid-column:1/-1;
}

@media(max-width:700px){
  .formGrid{
    grid-template-columns:1fr;
  }

  .formGrid .full{
    grid-column:auto;
  }

  header{
    align-items:flex-start;
    flex-direction:column;
  }
}

.formActions{
  display:flex;
  gap:10px;
  margin-top:20px;
  flex-wrap:wrap;
}

.message{
  min-height:22px;
  color:#b8e0b8;
  margin-top:15px;
