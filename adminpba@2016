function timeToMinutes(value){

  const text =
    String(value || "")
      .trim()
      .toUpperCase();

  const match =
    text.match(
      /^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/
    );

  if(!match)
    return 0;

  let hour =
    parseInt(match[1],10);

  const minute =
    parseInt(match[2] || "0",10);

  if(match[3] === "PM" && hour !== 12)
    hour += 12;

  if(match[3] === "AM" && hour === 12)
    hour = 0;

  return hour * 60 + minute;

}


function adminClassMatchesSearch(
  c,
  query
){

  const q =
    normalizeText(query);

  if(!q)
    return true;

  const searchable = [

    c.class_name,
    c.teacher,
    c.branch,
    c.day,
    c.studio,
    c.start_time,
    c.end_time

  ]
  .map(
    value =>
      normalizeText(
        normalizeClassName(value)
      )
  )
  .join(" ");

  return q
    .split(" ")
    .filter(Boolean)
    .every(
      token =>
        searchable.includes(token)
    );

}


function renderAdminClasses(){

  const list =
    document.getElementById(
      "adminList"
    );

  const search =
    document.getElementById(
      "adminScheduleSearch"
    );

  const info =
    document.getElementById(
      "adminSearchInfo"
    );

  const query =
    search?.value || "";

  const days = [
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
  ];

  const filtered =
    classes
      .filter(
        c =>
          adminClassMatchesSearch(
            c,
            query
          )
      )
      .sort(
        (a,b)=>{

          const branch =
            String(a.branch)
              .localeCompare(
                String(b.branch)
              );

          if(branch !== 0)
            return branch;

          const day =
            days.indexOf(a.day) -
            days.indexOf(b.day);

          if(day !== 0)
            return day;

          return (
            timeToMinutes(a.start_time) -
            timeToMinutes(b.start_time)
          );

        }
      );

  list.innerHTML = "";

  info.textContent =
    query
      ? `Showing ${filtered.length} of ${classes.length} classes`
      : `Showing all ${classes.length} classes`;

  if(!filtered.length){

    const empty =
      document.createElement("div");

    empty.className =
      "adminItem";

    empty.textContent =
      "No matching classes found.";

    list.appendChild(empty);

    return;

