<script>

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
  "https://valwxktxaknqwmozdzyx.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_d0M6R4ILw8bduSv_2wIrdQ_txzl3JrJ";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/* =========================================================
   GLOBALS
========================================================= */

let currentUser = null;
let classes = [];
let branches = [];
let teachers = [];
let admins = [];

const fallbackBranches = [
  "Maadi",
  "New Cairo",
  "Sheikh Zayed",
  "New Giza"
];

const defaultTeacherColors = {

  "Mr. Mohamed Fadlon":
    "#DCE6F1",

  "Ms. Nada Nabil":
    "#F3B3A5",

  "Ms. Noran Mohamed":
    "#ADD8E6",

  "Ms. Victoria Pashchenko":
    "#CCFFCC",

  "Ms. Marina Ehab":
    "#F2C2D4",

  "Ms. Valentina Kendall":
    "#E8C6DC",

  "Ms. Nada Amr":
    "#B4C7E7",

  "Ms. Mahinour Ahmed":
    "#F6EB20",

  "Ms. Una Stepanovic":
    "#FFF200",

  "Ms. Rena Takemura":
    "#99CCFF",

  "Ms. Luiza Pigatto":
    "#D461A6"

};

let teacherColors = {
  ...defaultTeacherColors
};


/* =========================================================
   NORMALIZATION
========================================================= */

function normalizeText(value){

  return String(value || "")
    .toLowerCase()
    .normalize("NFKC")
    .replace(/\s+/g," ")
    .trim();

}

function normalizeClassName(name){

  if(!name)
    return "";

  return String(name)
    .replace(
      /^\s*Competition\b/i,
      "Premier"
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();

}


/* =========================================================
   LOGIN
========================================================= */

async function adminLogin(){

  const email =
    document.getElementById(
      "adminEmail"
    ).value.trim();

  const password =
    document.getElementById(
      "adminPassword"
    ).value;

  const error =
    document.getElementById(
      "loginError"
    );

  error.textContent = "";

  if(!email || !password){

    error.textContent =
      "Enter your email and password.";

    return;

  }

  const {
    data,
    error:authError
  } =
    await supabaseClient.auth
      .signInWithPassword({

        email,
        password

      });

  if(authError){

    error.textContent =
      authError.message;

    return;

  }

  await finishAdminLogin(
    data.user,
    error
  );

}


async function finishAdminLogin(
  user,
  errorElement
){

  const {
    data:admin,
    error:adminError
  } =
    await supabaseClient
      .from("admins")
      .select(
        "id,email,role"
      )
      .eq(
        "id",
        user.id
      )
      .maybeSingle();

  if(adminError){

    await supabaseClient.auth.signOut();

    errorElement.textContent =
      "Admin database error: " +
      adminError.message;

    return;

  }

  if(!admin){

    await supabaseClient.auth.signOut();

    errorElement.textContent =
      "This account is not authorized as an administrator.";

    return;

  }

  currentUser = user;

  currentUser.adminRole =
    admin.role || "admin";

  await openAdmin();

}


/* =========================================================
   INVITATION / PASSWORD FLOW
========================================================= */

async function checkInvitationLink(){

  const hash =
    window.location.hash;

  const search =
    window.location.search;

  const hasAccessToken =
    hash.includes("access_token=");

  const isInvite =
    hash.includes("type=invite") ||
    hash.includes("type=recovery") ||
    search.includes("type=invite") ||
    search.includes("type=recovery");

  if(
    hasAccessToken &&
    isInvite
  ){

    document.getElementById(
      "createPasswordOverlay"
    ).style.display =
      "flex";

    return true;

  }

  return false;

}


async function restoreSession(){

  const invitation =
    await checkInvitationLink();

  if(invitation)
    return;

  const {
    data,
    error
  } =
    await supabaseClient.auth
      .getSession();

  if(error){

    console.error(
      "Session restore error:",
      error
    );

    return;

  }

  const session =
    data?.session;

  if(!session){

    document.getElementById(
      "loginOverlay"
    ).style.display =
      "flex";

    return;

  }

  const {
    data:userData
  } =
    await supabaseClient.auth
      .getUser();

  const user =
    userData?.user;

  if(!user){

    document.getElementById(
      "loginOverlay"
    ).style.display =
      "flex";

    return;

  }

  const {
    data:admin
  } =
    await supabaseClient
      .from("admins")
      .select(
        "id,email,role"
      )
      .eq(
        "id",
        user.id
      )
      .maybeSingle();

  if(!admin){

    await supabaseClient.auth.signOut();

    document.getElementById(
      "loginOverlay"
    ).style.display =
      "flex";

    return;

  }

  currentUser =
    user;

  currentUser.adminRole =
    admin.role || "admin";

  await openAdmin();

}


/* =========================================================
   CREATE PASSWORD
========================================================= */

async function createAdminPassword(){

  const password =
    document.getElementById(
      "newAdminPassword"
    ).value;

  const confirmPassword =
    document.getElementById(
      "confirmAdminPassword"
    ).value;

  const error =
    document.getElementById(
      "createPasswordError"
    );

  error.textContent = "";

  if(!password || !confirmPassword){

    error.textContent =
      "Please enter and confirm your password.";

    return;

  }

  if(password.length < 6){

    error.textContent =
      "Password must be at least 6 characters.";

    return;

  }

  if(password !== confirmPassword){

    error.textContent =
      "The passwords do not match.";

    return;

  }

  const {
    error:updateError
  } =
    await supabaseClient.auth
      .updateUser({

