      details.textContent =
        `${c.branch} · ${c.day} · ${c.studio} · ` +
        `${c.start_time} – ${c.end_time}` +
        (
          c.teacher
            ? ` · ${c.teacher}`
            : ""
        );

      infoBox.appendChild(name);
      infoBox.appendChild(details);

      const actions =
        document.createElement(
          "div"
        );

      actions.className =
        "adminActions";

      const edit =
        document.createElement(
